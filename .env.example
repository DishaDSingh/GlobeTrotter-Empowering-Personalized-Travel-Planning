# --- Database ---
# Defaults to a local SQLite file so the app runs with zero setup.
DATABASE_URL=sqlite:///./globetrotter.db

# Other options:
# A local PostgreSQL server you installed yourself:
# DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:5432/postgres
# Supabase Postgres (see the Deployment section in README.md for the exact
# steps - use the Session pooler connection string, not the direct one, or
# it may fail to resolve on IPv4-only networks):
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:password@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase (optional; only needed if you switch DATABASE_URL to Supabase Postgres) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Maps ---
# Not required: the frontend uses Leaflet + OpenStreetMap by default (no key needed).
# Set this only if you want to switch the map to Mapbox tiles.
MAPBOX_TOKEN=

# --- AI features (optional) ---
# Without this key, /ai/generate-itinerary and /ai/optimize-budget fall back to a
# deterministic rule-based generator, so AI features work out of the box.
OPENAI_API_KEY=

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8000
